# Copy this file to .env on the VPS. Never commit the real .env.
# Point both DNS records to the VPS public IP before starting Caddy.
WEB_DOMAIN=app.example.com
SCANNER_DOMAIN=scanner.example.com
# Shared parent domain for the secure session cookie; replace with your actual domain.
TRADESCANNER_COOKIE_DOMAIN=.example.com

POSTGRES_DB=tradescanner
POSTGRES_USER=tradescanner
# Generate a hex-only password, e.g. openssl rand -hex 24 (safe in DATABASE_URL).
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Generate two independent long random secrets (for example with: openssl rand -hex 32).
TRADESCANNER_SESSION_SECRET=REPLACE_WITH_RANDOM_SESSION_SECRET
TRADESCANNER_SIGNAL_INGEST_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_INGEST_SECRET

# Alpaca market-data credentials only; leave blank until Paper data access is configured.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
