FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY requirements.txt /tmp/scanner-requirements.txt
RUN pip install --no-cache-dir -r /tmp/scanner-requirements.txt
COPY . /app

EXPOSE 8501
CMD ["sh", "/app/deploy/self-host/start-scanner.sh"]
